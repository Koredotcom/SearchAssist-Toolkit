# Copy to .env and edit paths for your machine.
# cp .env.example .env
#
# This file takes precedence over shell exports.

CRAWLER_PORT=8080
CRAWLER_PROFILE_ROOT=./data/profiles
CRAWLER_SPOOL_DIR=./data/spool
CRAWLER_CHROME_CHANNEL=chrome

# always = own Xvfb display, browser hidden (servers / AWS)
# auto   = reuse an existing DISPLAY if one exists (desktop Chrome visible)
# never  = always use the real display
CRAWLER_XVFB_MODE=always

CRAWLER_PAGE_TIMEOUT_MS=60000
# Wait budget for Cloudflare "Just a moment..." interstitials.
CRAWLER_CHALLENGE_WAIT_SECONDS=90
CRAWLER_JOB_BUDGET_SECONDS=7200
CRAWLER_CONTEXT_RECYCLE_EVERY=50
# CRAWLER_RSS_LIMIT_MB=
CRAWLER_CALLBACK_RETRY_MAX=5

# KoreServer public API base for page/complete callbacks.
# Required for Findly crawls: Findly no longer sends callbackUrl/completeUrl
# (a static Findly host would be localhost in every env and break prod).
# The SDK builds:
#   {host}/api/customCrawler/callback/{streamId}/{jobId}
#   {host}/api/customCrawler/complete/{streamId}/{jobId}
# Set this to the KoreServer public API base THIS SDK deployment can reach.
CRAWLER_CALLBACK_PUBLIC_HOST=http://localhost
# Optional absolute overrides (payload URLs still win when present):
# CRAWLER_CALLBACK_URL=
# CRAWLER_COMPLETE_URL=
# KoreServer PublicAPI JWT for the ``auth`` header. The SDK does not mint JWTs.
# Payload reqHeaders with the same key override this value.
CRAWLER_CALLBACK_AUTH_HEADER=

# Retry-failures jobs (sourceType=crawl_retry) read the source's failed URLs from
#   {host}/api/public/bot/{streamId}/search/get-content-by-status
# Host and JWT default to the callback values above; override only if the public
# API lives elsewhere or needs a different token.
# CRAWLER_CONTENT_STATUS_HOST=
# CRAWLER_CONTENT_STATUS_AUTH_HEADER=
# CRAWLER_CONTENT_STATUS_PATH=/api/public/bot/{streamId}/search/get-content-by-status
CRAWLER_CONTENT_STATUS_LIMIT=200

# false = ephemeral Chrome (default). true = use warmed per-host profile
# after capture (/ui or warmup_profile). Per-job override:
# advanceSettings.useProfile.
CRAWLER_USE_PROFILE=false

# Interactive capture UI (GET /ui) needs Xvfb + x11vnc + websockify + noVNC.
CRAWLER_VNC_ENABLED=true
CRAWLER_VNC_HOST=localhost
CRAWLER_NOVNC_WEB_DIR=/opt/noVNC
#Path to VNC
