{
    "UXO or SA": {
        "app_id": "<UXO or SA stream ID>",
        "client_id": "<UXO or SA client ID>",
        "client_secret": "<UXO or SA client secret>",
        "domain": "<SA or UXO domain url>"
    },
    "openai": {
        "model_name": "<EVALUATION_MODEL_NAME>",
        "embedding_name": "<EVALUATION_EMBEDDING_NAME>"
    },
    "azure": {
        "openai_api_version": "<API VERSION>",
        "base_url": "<BASE URL>",
        "model_name": "<MODEL NAME>",
        "model_deployment": "<MODEL DEPLOYMENT>",
        "embedding_deployment": "<EMBEDDING DEPLOYMENT>",
        "embedding_name": "<EMBEDDING NAME>"
    },
    "cost_of_model":{
        "input": 0.00000015,
        "output": 0.0000006
    },
    "MongoDB": {
        "url": "<MONGO URL>",
        "dbName": "<DB NAME>",
        "collectionName": "<COLLECTION NAME>"
    },
    "model_type": "openai",
    "max_concurrent_requests_for_search_api": 3,
    "max_concurrent_requests_for_evaluation": 3,
    "search_api_sleep_seconds": 0,
    "search_api": {
        "version": "v2",
        "endpoint": "search/v2/advanced-search",
        "answerSearch": true,
        "payload": {
            "includeChunksInResponse": true,
            "searchResults": false,
            "maxNumOfChunks": 15
        }
    },
    "question_generation": {
        "num_questions": 100,
        "chunks_per_question": 50,
        "questions_per_batch": 5,
        "min_chunks_per_question": 1,
        "max_pagination_attempts": 10,
        "target_specific_data": false,
        "max_chunks_per_question": 10,
        "elaborate_queries": false,
        "max_api_retries": 3,
        "max_generation_attempts": 20,
        "llm_temperature": 0.7,
        "llm_max_tokens": 100,
        "default_total_chunks": 10000,
        "language_filter": {
            "enabled": true,
            "target_language": "en",
            "allowed_languages": ["en"],
            "exclude_code_content": true
        },
        "chunk_list_api": {
            "url_template": "https://{domain}/api/public/bot/{streamId}/chunk/list"
        }
    }
}