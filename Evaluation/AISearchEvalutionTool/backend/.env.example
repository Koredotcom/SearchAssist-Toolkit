# ── Database ──────────────────────────────────────────────────────────────────
# Primary DB config lives in ./config.json.
# Optional env vars below override config.json values when set.

# sqlite keeps the original local file behavior. mongodb uses local/remote MongoDB.
DB_BACKEND=

# SQLite fallback/default. Leave blank to use ../data/eval.db.
SQLITE_DB_PATH=

# MongoDB settings used when DB_BACKEND=mongodb.
MONGODB_URI=
MONGODB_DATABASE=

# Kore.ai credentials are stored per-app in the database (configured via UI)
# LLM API keys are also stored per-app in the database (API Keys page).
