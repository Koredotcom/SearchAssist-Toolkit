# ── Database ──────────────────────────────────────────────────────────────────
# Backend database config primarily lives in backend/config.json.
# Optional env vars below override backend/config.json values when set.
DB_BACKEND=

# Path to the SQLite file. Leave blank for ./data/eval.db.
DB_PATH=
SQLITE_DB_PATH=

# Used when DB_BACKEND=mongodb.
MONGODB_URI=
MONGODB_DATABASE=

# NOTE: OpenAI and Anthropic API keys are stored per-app inside the database.
# Configure them in the app's API Keys settings page — no global keys needed.
